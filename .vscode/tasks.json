{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Lead Insight Hub",
      "type": "process",
      "command": "pnpm",
      "args": ["dev"],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": false
      }
    },
    {
      "label": "Typecheck workspace",
      "type": "process",
      "command": "pnpm",
      "args": ["run", "typecheck"],
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build workspace",
      "type": "process",
      "command": "pnpm",
      "args": ["run", "build"],
      "problemMatcher": ["$tsc"]
    }
  ]
}
